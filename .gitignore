# Canonical recipe is tracked; generated catalog, history, and runtime state stay local.
/.workflow/*
!/.workflow/
!/.workflow/workflow.yaml

# Local scratch directories used during workflow experiments.
outputs/
work/
registro-flow/
registration-test/

# External Skills are installed separately and are not vendored in this repo.
.agents/skills/grill-me/
.agents/skills/grilling/
.agents/skills/writing-plans/

# OS, editor, logs, and temporary files.
.DS_Store
*.log
*.tmp
*.temp
*.swp
*.swo
*~
